# ---- Required in production ----
SECRET_KEY=replace-with-a-long-random-string   # python -c "import secrets; print(secrets.token_urlsafe(48))"
POSTGRES_PASSWORD=replace-me

# ---- GitHub scanning (strongly recommended) ----
# Create at https://github.com/settings/tokens (classic, no scopes needed for public repos;
# add "repo" scope only if you want to scan your own private repos). 60 req/h without it, 5,000 with it.
GITHUB_TOKEN=

# ---- Email alerts (any SMTP provider: Gmail app password, SendGrid, Mailgun, Brevo...) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=GhostTrace <alerts@yourdomain.com>

# ---- Optional ----
# Have I Been Pwned API key (paid). Without it GhostTrace uses the free XposedOrNot breach database.
HIBP_API_KEY=
# Public URL of the site, used in alert email links
FRONTEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:8000
MONITOR_INTERVAL_MINUTES=60
# Number of reverse proxies in front of the app (1 on Render/Railway, 0 if exposed directly); used for login rate limiting
TRUSTED_PROXY_HOPS=0
